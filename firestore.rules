rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null
        && request.auth.token.email == 'info.teamhaim@gmail.com';
    }
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // Self-writes are allowed, but a non-coach can never set their own
      // (or anyone else's) role to 'coach' this way — only the real
      // coach account (isCoach(), checked against the verified Google
      // auth token email) can ever write role: 'coach'. Without this,
      // the client-side check in auth-context.tsx is cosmetic only:
      // anyone signed in could call Firestore directly and grant
      // themselves the coach role.
      // Athletes can no longer self-write `physiology` (T1/T2/T3 source of
      // truth) either — Lab editing is coach-only; maxHR/restingHR and
      // every other self-writable field are unaffected.
      allow write: if isCoach()
        || (isSelf(userId) && request.resource.data.role != 'coach'
            && (resource == null
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['physiology'])));
      match /journey/{journeyId} {
        allow read, write: if isSelf(userId) || isCoach();
      }
    }

    match /workouts/{workoutId} {
      allow read: if request.auth != null;
      allow write: if isCoach();
    }

    match /assignedWorkouts/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isCoach();
      // Athletes may complete/skip their workout or move it to another day
      // (movedByAthlete/movedFromDate flag the move for the coach).
      // strengthProgress: per-exercise set completion + logged weight from
      // Lift Mode (components/athlete/lift-mode.tsx) — same self-only
      // update rule as the rest of this list.
      allow update: if isCoach()
        || (request.auth != null
            && resource.data.athleteId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedAt', 'athleteNotes', 'updatedAt',
                         'scheduledDate', 'movedByAthlete', 'movedFromDate',
                         'strengthProgress']));
    }

    // Coach-managed exercise library (name, uploaded demo video, target
    // sets/reps, instructions) referenced by structured strength workouts.
    // Any signed-in user (coach or athlete) reads it; only the coach edits.
    match /exerciseLibrary/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if isCoach();
    }

    // Durable per-completion exercise history (weight logged per set),
    // written by Lift Mode when a strength workout is finished — powers the
    // athlete's progress chart at /athlete/progress. Separate from the
    // overwritable assignedWorkouts.strengthProgress field. Same self-serve
    // shape as lactateTests below.
    match /exerciseLogs/{docId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.athleteId == request.auth.uid);
      allow create, update: if isCoach()
        || (request.auth != null && request.resource.data.athleteId == request.auth.uid);
      allow delete: if isCoach();
    }

    // Coach-diagnosed injury records (per athlete, per body zone). Write is
    // coach-only (unlike exerciseLogs/lactateTests self-serve); athlete can
    // only read their own, and only once the coach flips visibleToAthlete —
    // same per-record gating spirit as users.labVisibleToAthlete.
    match /injuries/{docId} {
      allow read: if request.auth != null
        && (isCoach()
            || (resource.data.athleteId == request.auth.uid
                && resource.data.visibleToAthlete == true));
      allow write: if isCoach();
    }

    match /logs/{logId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.athleteId == request.auth.uid);
      allow create: if request.auth != null
        && (isCoach() || request.resource.data.athleteId == request.auth.uid);
      allow update, delete: if isCoach()
        || (request.auth != null && resource.data.athleteId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /goals/{goalId} {
      allow read, write: if request.auth != null;
    }

    match /settings/googleSheets {
      allow read: if request.auth != null;
      allow write: if isCoach();
    }

    match /strava_connections/{docId} {
      allow read, write: if request.auth != null;
    }

    match /weeklyNotes/{docId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.athleteId == request.auth.uid);
      allow create, delete: if isCoach();
      allow update: if isCoach()
        || (request.auth != null
            && resource.data.athleteId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['readByAthlete']));
    }

    match /lactateTests/{docId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.athleteId == request.auth.uid);
      // Lab editing (new test, apply, delete) is coach-only — reversed
      // from the earlier self-serve design; athletes can still read their
      // own tests once the coach makes the lab visible to them
      // (labVisibleToAthlete).
      allow create, update, delete: if isCoach();
    }

    match /coachMessages/{docId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.athleteId == request.auth.uid);
      allow create, delete: if isCoach();
      allow update: if isCoach()
        || (request.auth != null
            && resource.data.athleteId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read', 'readAt']));
    }

    // Push notification tokens — doc id is the user's own uid. Every
    // athlete and the coach write their own token here when enabling
    // notifications; there was no rule for this collection at all before,
    // so every registration was silently denied (default-deny) and no one
    // could receive pushes.
    match /fcmTokens/{userId} {
      allow read, write: if isSelf(userId) || isCoach();

      // One token doc per DEVICE (lib/notifications.ts) instead of one flat
      // doc per user — a second device registering no longer silently
      // overwrites and steals notifications from the first. Rules don't
      // cascade to subcollections, so this needs its own explicit match.
      match /tokens/{tokenId} {
        allow read, write: if isSelf(userId) || isCoach();
      }
    }

    // Days off (sick/trip/other) — either the athlete or the coach can mark
    // a date range as no-workout, which suppresses reminder pushes.
    match /daysOff/{docId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.athleteId == request.auth.uid);
      allow create: if request.auth != null
        && (isCoach() || request.resource.data.athleteId == request.auth.uid);
      allow delete: if isCoach()
        || (request.auth != null && resource.data.athleteId == request.auth.uid);
    }

    // Scheduled reminder notifications (morning/evening cron jobs etc.)
    match /scheduledNotifications/{docId} {
      allow read: if request.auth != null
        && (isCoach() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && (isCoach() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isCoach();
    }

    // Public "apply to work with me" form (app/apply) — anyone, signed in
    // or not, can submit one. Forced to status 'new' on create (can't
    // self-accept). Read/update beyond that is coach-only, EXCEPT: once
    // the coach has accepted a lead, the person who just signed up with
    // that exact email (checked against their own verified auth token,
    // not a client-supplied value) can read it once to pull their
    // application data into their new profile, and flip its status to
    // 'converted' — nothing else. This is what lets contexts/auth-
    // context.tsx auto-fill a new athlete's profile from their accepted
    // application without needing admin/server credentials.
    match /leads/{leadId} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0;
      allow read: if isCoach()
        || (request.auth != null && resource.data.email == request.auth.token.email);
      allow update: if isCoach()
        || (request.auth != null
            && resource.data.email == request.auth.token.email
            && resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isCoach();
    }
  }
}
